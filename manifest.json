{
  "manifest_version": 3,
  "name": "LLM Prompt Queue",
  "version": "1.0",
  "description": "Queues multiple prompts for ChatGPT and Google Gemini.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}