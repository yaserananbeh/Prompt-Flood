{
  "manifest_version": 3,
  "name": "Prompt Orchestrator",
  "version": "2.5.0",
  "description": "Queue, pause, and broadcast prompts across ChatGPT, Gemini, Claude, Kimi, DeepSeek, Doubao, and Perplexity. Personas, checkpoints, history.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://kimi.com/*",
    "*://www.kimi.com/*",
    "*://chat.deepseek.com/*",
    "*://doubao.com/*",
    "*://www.doubao.com/*",
    "*://perplexity.ai/*",
    "*://www.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://kimi.com/*",
        "*://www.kimi.com/*",
        "*://chat.deepseek.com/*",
        "*://doubao.com/*",
        "*://www.doubao.com/*",
        "*://perplexity.ai/*",
        "*://www.perplexity.ai/*"
      ],
      "js": ["platforms.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
