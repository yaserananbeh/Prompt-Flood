{
  "manifest_version": 3,
  "name": "LLM Prompt Queue",
  "version": "2.3.2",
  "description": "Queue prompts for ChatGPT, Gemini, and Claude with personas, checkpoints, history, and broadcast.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": ["platforms.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
